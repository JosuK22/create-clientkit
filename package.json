{
  "name": "create-clientkit",
  "version": "0.1.0",
  "description": "Create the boring foundation of your next client website in seconds.",
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "client-website",
    "freelance",
    "agency",
    "astro",
    "starter"
  ],
  "license": "MIT",
  "author": "{{AUTHOR_NAME}}",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "create-clientkit": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/node": "^22.15.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
