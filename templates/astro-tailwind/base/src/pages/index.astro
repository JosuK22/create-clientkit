---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="container-page wrap">
    <h1>Placeholder</h1>
    <p>
      This page comes from the template's base layer and is replaced by the
      selected mode. If you are seeing it, the mode layer did not apply.
    </p>
  </div>
