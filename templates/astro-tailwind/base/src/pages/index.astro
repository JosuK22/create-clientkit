<style>
  .wrap {
    padding-block: var(--spacing-section);
  }

  h1 {
    margin: 0 0 1rem;
    font-size: var(--text-h1);
    font-weight: 600;
  }

  p {
    margin: 0;
    max-width: 60ch;
    color: var(--color-muted);
  }
</style>
